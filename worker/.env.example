# Local development only. Never commit a real .env file.
PORT=8787
WORKER_ID=zero-lag-worker-local
NETLIFY_API_URL=https://zerolagmomentagent.netlify.app/.netlify/functions/worker-connection
WORKER_API_SECRET=replace-with-the-same-random-secret-set-in-Netlify and GitHub
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE
DATABASE_SSL=true
SCHEDULE_MINUTES=90
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-2.5-flash
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_flash_v2_5
YOUTUBE_API_KEY=
AUTO_PUBLISH=false
SHORTS_PER_DAY=10
LONGS_PER_DAY=1
SCENES_PER_SHORT=5
SCENES_PER_LONG=10
OUTPUT_DIR=./output
DATA_DIR=./data
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
